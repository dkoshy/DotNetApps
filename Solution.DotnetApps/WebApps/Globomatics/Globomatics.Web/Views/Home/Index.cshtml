@model IEnumerable<Product>
@inject IStateRepository stateRepository

@{
    ViewData["Title"] = "Home";
}

<div class="row">
    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                @*  TBA: Product List *@
               @*  <vc:product-list></vc:product-list> *@
               @await Component.InvokeAsync("ProductList")
            </div>
        </div>
    </div>
    <div class="col-sm-5">
        <div class="card">
            <div class="card-body">
                <vc:shopping-cart cart-id="@(stateRepository.GetValue("CartId"))" is-compact="true" />
            </div>
        </div>
    </div>

</div>